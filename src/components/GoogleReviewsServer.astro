            {overallRating.toFixed(1)} ★
          </span>
        </div>
        <p className="text-xs text-[#b4f0cd] opacity-90 mt-0.5">
          {totalReviewsCount}+ opiniones reales en Oriente Antioqueño
        </p>
      </div>
    </div>

    <div class="flex items-center gap-2 flex-wrap">
      <a
        href={directMapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="px-4 py-3 rounded-2xl bg-white/10 hover:bg-white/20 text-white text-xs font-bold transition-all shadow-sm flex items-center gap-1.5"
      >
        <span class="material-symbols-outlined text-[18px]">map</span>
        <span>Ver en Google Maps</span>
      </a>

      <a
        href="https://wa.me/c/573052417854"
        target="_blank"
        rel="noopener noreferrer"
        class="px-5 py-3 rounded-2xl bg-[#7c2800] hover:bg-[#571900] text-white text-xs font-bold transition-all shadow-md flex items-center gap-2"
      >
        <span class="material-symbols-outlined text-[18px]">chat</span>
        <span>Escribir al WhatsApp</span>
      </a>
    </div>
  </div>

  <!-- Error / Aviso Informativo si aplica -->
  {fetchError && (
    <div class="p-3 bg-amber-50 border border-amber-200 rounded-xl text-amber-900 text-xs flex items-center gap-2">
      <span class="material-symbols-outlined text-[18px]">info</span>
      <span>Modo respaldo: {fetchError}. Mostrando reseñas destacadas.</span>
    </div>
  )}

  <!-- Grid de Reseñas Renderizadas en Servidor (SSR/SSG) -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    {reviews.map((review) => (
      <article class="p-5 rounded-2xl bg-white border border-gray-200 shadow-sm flex flex-col justify-between gap-3 hover:shadow-md transition-shadow">
        <div class="space-y-2.5">
          <!-- Cabecera del Autor -->
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <img
                src={review.profile_photo_url || 'https://lh3.googleusercontent.com/a/default-user'}
                alt={`Foto de perfil de ${review.author_name}`}
                class="w-10 h-10 rounded-full object-cover border border-gray-200"
                loading="lazy"
                width="40"
                height="40"
              />
              <div>
                <h3 class="text-xs font-bold text-[#1a1c1c] leading-tight flex items-center gap-1">
                  {review.author_name}
                  <span class="material-symbols-outlined text-blue-600 text-[14px]" title="Reseña en Google">
                    verified
                  </span>
                </h3>
                <span class="text-[11px] text-gray-500">
                  {review.relative_time_description}
                </span>
              </div>
            </div>
          </div>

          <!-- Estrellas -->
          <div class="flex items-center gap-1 text-amber-500 text-sm">
            {Array.from({ length: review.rating }).map(() => (
              <span>★</span>
            ))}
          </div>

          <!-- Texto de la Reseña -->
          <p class="text-xs text-[#404943] leading-relaxed">
            "{review.text}"
          </p>
        </div>

        <div class="pt-2 border-t border-gray-100 flex items-center justify-between text-[10px] text-gray-400">
          <span>Verificada en Google Maps</span>
          <span class="text-[#003622] font-bold">5.0 ★</span>
        </div>
      </article>
    ))}
  </div>
</section>
