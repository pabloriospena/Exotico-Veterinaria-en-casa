if (apiKey && placeId) {
  try {
    // Endpoint primario: Google Places Details API (placeDetails)
    const placeDetailsUrl = `https://maps.googleapis.com/maps/api/place/details/json?place_id=${encodeURIComponent(placeId)}&fields=name,rating,user_ratings_total,reviews&language=es&key=${encodeURIComponent(apiKey)}`;
    const response = await fetch(placeDetailsUrl);
    
    if (response.ok) {
      const data: PlaceDetailsResponse = await response.json();
      if (data.status === 'OK' && data.result && data.result.reviews) {
        overallRating = data.result.rating || 5.0;
        totalReviewsCount = data.result.user_ratings_total || data.result.reviews.length;
        reviews = data.result.reviews;
      }
    }

    // Endpoint secundario: Places API (New v1) si la primera API no retorna reseñas
    if (reviews.length === 0) {
      const newApiUrl = `https://places.googleapis.com/v1/places/${encodeURIComponent(placeId)}?languageCode=es`;
      const newApiResponse = await fetch(newApiUrl, {
        headers: {
          'X-Goog-Api-Key': apiKey,
          'X-Goog-FieldMask': 'id,displayName,rating,userRatingCount,reviews',
        },
      });

      if (newApiResponse.ok) {
        const data = await newApiResponse.json();
        if (data && data.reviews && data.reviews.length > 0) {
          overallRating = data.rating || 5.0;
          totalReviewsCount = data.userRatingCount || data.reviews.length;
          reviews = data.reviews.map((r: any) => ({
            author_name: r.authorAttribution?.displayName || 'Cliente de Google',
            profile_photo_url: r.authorAttribution?.photoUri || 'https://lh3.googleusercontent.com/a/default-user',
            rating: r.rating || 5,
            relative_time_description: r.relativePublishTimeDescription || 'Hace un tiempo',
            text: r.text?.text || r.originalText?.text || '',
          }));
        }
      }
    }

    // Intento 3: Legacy Places Details API por CID exacto (0xcfc0745fad06bf8c => 14969966144577880972)
    if (reviews.length === 0) {
      const cidUrl = `https://maps.googleapis.com/maps/api/place/details/json?cid=14969966144577880972&fields=name,rating,user_ratings_total,reviews&language=es&key=${apiKey}`;
      const cidResponse = await fetch(cidUrl);
      if (cidResponse.ok) {
        const cidData: PlaceDetailsResponse = await cidResponse.json();
        if (cidData.status === 'OK' && cidData.result && cidData.result.reviews) {
          overallRating = cidData.result.rating || 5.0;
          totalReviewsCount = cidData.result.user_ratings_total || cidData.result.reviews.length;
          reviews = cidData.result.reviews;
          fetchError = null;
        } else if (cidData.status && cidData.status !== 'OK') {
          fetchError = `Estado API Google: ${cidData.status}`;
        }
      }
    }

    if (reviews.length === 0) {
      if (!fetchError) {
        fetchError = 'Respuesta de Google recibida. Mostrando catálogo de reseñas reales de respaldo.';
      }
      reviews = FALLBACK_REVIEWS;
    } else {
      fetchError = null;
    }
  } catch (err: any) {
    fetchError = err.message || 'Error al conectar con la API de Google Places';
    reviews = FALLBACK_REVIEWS;
  }
} else {
  reviews = FALLBACK_REVIEWS;
}
---

<section class="flex flex-col gap-6 w-full max-w-5xl mx-auto px-4 py-8">
  <!-- Cabecera de Puntuación General -->
  <div class="bg-[#003622] text-white p-6 rounded-3xl flex flex-col sm:flex-row items-center justify-between gap-4 shadow-md">
